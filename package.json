{
  "name": "journeys-takeoff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env --use-env-proxy server.mjs",
    "visuals:generate": "node --env-file-if-exists=.env --use-env-proxy scripts/generate-visuals.mjs",
    "test": "node --test tests/api.test.mjs tests/timeline.test.mjs",
    "visuals:cutout": "node --env-file-if-exists=.env --use-env-proxy scripts/remove-background.mjs",
    "test:browser": "playwright test",
    "visuals:film": "node --env-file-if-exists=.env --use-env-proxy scripts/generate-film.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "three": "^0.186.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
